# Line endings matter here, and getting them wrong breaks things silently.
#
# A shell script checked out with CRLF fails on Linux with an opaque
# "bad interpreter: /usr/bin/env bash^M" - which looks like the script is
# broken rather than the checkout. Since AEGIS is developed on Windows and
# deployed to Linux, pin the ones that must be LF.

* text=auto

# Must be LF: executed by an interpreter that chokes on CR
*.sh        text eol=lf
*.py        text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
Caddyfile   text eol=lf
Dockerfile  text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.yml       text eol=lf

# Must be CRLF: cmd.exe is unreliable with LF-only batch files
*.cmd       text eol=crlf
*.bat       text eol=crlf

# PowerShell is fine either way, but Windows tooling expects CRLF
*.ps1       text eol=crlf

# Never touch: binary or byte-exact
*.png       binary
*.jpg       binary
*.gif       binary
*.webp      binary
*.pdf       binary
*.ico       binary
